# TMDB v3 API key. Create one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace_with_your_tmdb_v3_api_key
# Turso database for cloud sync (optional; without it, data is saved under data/).
# Create one with `turso db create` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_with_your_turso_auth_token
# Encrypts the Money app's docs in the database (AES-256-GCM). Required for the Money app.
# 32 random bytes, base64: `openssl rand -base64 32`. Use the same value everywhere that shares
# the database, and keep a copy: without it the stored Money data can't be read.
MONEY_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32
# Optional: the family the Money app starts with, kept out of the repo. Server-only (never NEXT_PUBLIC_).
# Your names as they appear in statements, comma-separated:
MONEY_MY_NAMES="Asha Rao, Asha K Rao"
# Family members split by ";", each one's statement names by "," (the first is shown):
MONEY_FAMILY="Ravi Rao, Ravi K Rao; Meena Rao"

# Single-user login. All three are required; without them nobody can sign in.
APP_USERNAME=choose_a_username
APP_PASSWORD=choose_a_strong_password
# Random string used to sign the session cookie, e.g. `openssl rand -hex 32`
AUTH_SECRET=replace_with_a_long_random_string
